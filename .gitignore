# ================================
# General Files & System Artifacts
# ================================
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history/
.svn/
migrate_working_dir/

# ================================
# Flutter / Dart / Pub Related Files
# ================================

# Documentation generated by dartdoc.
**/doc/api/

# Dart & Flutter tool outputs
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# Package resolution and dependency files
.pub-cache/
.pub/

# The build/ directory contains output of the Flutter build process.
build/

# Uncomment the following line if you prefer not to version control pubspec.lock 
# (for applications, it is recommended to commit pubspec.lock to ensure consistency)
# pubspec.lock

# ================================
# iOS Specific Files & Folders
# ================================

# Xcode and Flutter generated files
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/ephemeral/

# CocoaPods
ios/Pods/
ios/.symlinks/

# Xcode workspace settings (auto-generated)
ios/Runner.xcworkspace/

# ================================
# Android Specific Files & Folders
# ================================

# Gradle build directory and cache
android/.gradle/
android/app/build/
android/build/

# Android Studio generated files (usually covered by IntelliJ settings below)
android/app/*.iml

# ================================
# Symbolication & Obfuscation Files
# ================================

# Symbol files generated for iOS apps (used for crash symbolication)
app.*.symbols

# Obfuscation mapping files (if code obfuscation is enabled)
app.*.map.json

# ================================
# IDE & Editor Settings
# ================================

# IntelliJ IDEA / Android Studio settings
*.iml
*.ipr
*.iws
.idea/

# VS Code settings (optional; uncomment if you want to ignore these)
.vscode/

# ================================
# End of .gitignore
# ================================
